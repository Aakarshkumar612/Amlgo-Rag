# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Virtual environment
venv/
env/

# Environment variables — never commit API keys
.env

# Project-specific generated files — large, auto-rebuilt by ingest.py
# vectordb and chunks are intentionally tracked — small pre-built indexes
# logs and cache remain excluded
logs/
.cache/

# HuggingFace model cache — re-downloaded automatically on first run
.cache/huggingface/

# Streamlit
.streamlit/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# Misc
*.log
*.tmp
# Allow Streamlit config
!.streamlit/
!.streamlit/config.toml
